[Desktop Entry]
Name=Start
Name[pt_BR]=Iniciar
Comment=Start menu as on Windows 11: search, pinned apps, all apps and open windows
Comment[pt_BR]=Menu Iniciar como o do Windows 11: pesquisa, apps fixados, todos os apps e janelas abertas
Type=Application
Exec=@bindir@/cosmic-ext-applet-central --start-button
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Start;Menu;Launcher;Apps;
Icon=start-here-symbolic
NoDisplay=true
X-CosmicApplet=true
X-HostWaylandDisplay=true

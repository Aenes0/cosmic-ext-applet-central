#!/bin/sh
# Super economia: o perfil Economia, mais a CPU sem boost e num CCD só, e a
# GPU no menor limite de consumo que o driver aceita, com o clock travado em
# até 1000 MHz e a memória em até 810 MHz: com vários monitores o driver a
# deixa no máximo (P0, ~35 W parada numa RTX 5070); assim ela desce para P5
# (~26 W).
# Instalado em /usr/local/bin pelo super-economia.sh, ao lado; o applet
# Central roda pelo pkexec, sem senha, pela regra do polkit.
# Uso: super-economia on | off | boot (de novo, se estava ligada) | status
set -u
state=/var/lib/super-economia/ativa
gpu_clock=1000
memory_clock=810

# As NVIDIA: o menor limite e o padrão, para voltar.
nvidia() {
    command -v nvidia-smi >/dev/null || return 0
    nvidia-smi --query-gpu=index,power.min_limit,power.default_limit --format=csv,noheader,nounits |
        while IFS=', ' read -r index min default; do
            if [ "$1" = on ]; then
                nvidia-smi -i "$index" -pm 1
                nvidia-smi -i "$index" -pl "$min"
                low=$(nvidia-smi -i "$index" --query-supported-clocks=gr --format=csv,noheader,nounits | sort -n | head -1)
                nvidia-smi -i "$index" -lgc "${low:-0},$gpu_clock"
                low=$(nvidia-smi -i "$index" --query-supported-clocks=mem --format=csv,noheader,nounits | sort -n | head -1)
                nvidia-smi -i "$index" -lmc "${low:-0},$memory_clock"
            else
                nvidia-smi -i "$index" -rgc
                nvidia-smi -i "$index" -rmc
                nvidia-smi -i "$index" -pl "$default"
                nvidia-smi -i "$index" -pm 0
            fi
        done >/dev/null
}

# As AMD e Intel integradas ou não: o nível mais baixo, ou o automático.
amdgpu() {
    for level in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
        [ -w "$level" ] && echo "$1" > "$level"
    done
}

# Tudo num CCD só: os núcleos dos outros desligados, que dormem no estado mais
# profundo e levam junto processos, threads do kernel e interrupções. Fica o
# CCD de maior prefcore ranking, o silício que segura a mesma frequência com
# menos tensão (num 5900XT, o CCD0: CPUs 0-7 e 16-23). Os desligados ficam
# anotados, para religar só eles. Com um CCD só, nada muda.
cpus=/sys/devices/system/cpu
offline=/var/lib/super-economia/cpus

# "0-7,16-23" → um número por linha.
expand() {
    echo "$1" | tr ',' '\n' | while IFS=- read -r first last; do
        seq "$first" "${last:-$first}"
    done
}

# A lista de CPUs do CCD que fica: a média do ranking, e no empate o da CPU 0.
best_ccd() {
    cat "$cpus"/cpu[0-9]*/cache/index3/shared_cpu_list 2>/dev/null | sort -u |
        while read -r list; do
            sum=0
            count=0
            for cpu in $(expand "$list"); do
                rank=$(cat "$cpus/cpu$cpu/cpufreq/amd_pstate_prefcore_ranking" 2>/dev/null || echo 0)
                sum=$((sum + rank))
                count=$((count + 1))
            done
            case ",$list" in ,0,* | ,0-*) has_cpu0=1 ;; *) has_cpu0=0 ;; esac
            echo "$((sum / count)) $has_cpu0 $list"
        done | sort -n -k1,1 -k2,2 | tail -1 | cut -d' ' -f3
}

one_ccd() {
    if [ "$1" = on ]; then
        keep=$(best_ccd)
        [ -n "$keep" ] || return 0
        keep=" $(expand "$keep" | tr '\n' ' ')"
        mkdir -p "${offline%/*}"
        : > "$offline"
        for online in "$cpus"/cpu[0-9]*/online; do
            cpu=${online%/online}
            cpu=${cpu##*/cpu}
            case "$keep" in *" $cpu "*) continue ;; esac
            echo "$cpu" >> "$offline"
            echo 0 > "$online"
        done
    else
        [ -e "$offline" ] || return 0
        while read -r cpu; do
            echo 1 > "$cpus/cpu$cpu/online"
        done < "$offline"
        rm -f "$offline"
    fi
    return 0
}

boost() {
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo "$1" > /sys/devices/system/cpu/cpufreq/boost
    # O intel_pstate diz ao contrário.
    [ -w /sys/devices/system/cpu/intel_pstate/no_turbo ] && echo $((1 - $1)) > /sys/devices/system/cpu/intel_pstate/no_turbo
    return 0
}

on() {
    powerprofilesctl set power-saver 2>/dev/null
    boost 0
    one_ccd on
    nvidia on
    amdgpu low
}

off() {
    one_ccd off
    boost 1
    nvidia off
    amdgpu auto
}

# Os applets, um por monitor, leem de novo.
changed() {
    busctl emit /io/github/Aenes0/SuperEconomia io.github.Aenes0.SuperEconomia Changed 2>/dev/null
    return 0
}

case "${1:-}" in
    on)
        mkdir -p "${state%/*}"
        touch "$state"
        on
        changed
        ;;
    off)
        rm -f "$state"
        off
        changed
        ;;
    boot)
        [ -e "$state" ] && on
        ;;
    status)
        [ -e "$state" ] && echo on || echo off
        ;;
    *)
        echo "uso: $0 on | off | boot | status" >&2
        exit 2
        ;;
esac
exit 0
